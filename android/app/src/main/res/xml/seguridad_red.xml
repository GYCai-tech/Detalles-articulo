<?xml version="1.0" encoding="utf-8"?>
<!--
  La API vive en la WiFi de la empresa y se habla por HTTP plano.

  Esto solo es aceptable mientras el servidor no salga de la LAN: las
  contrasenas del login viajan sin cifrar. El dia que la app tenga que
  funcionar desde 4G hay que poner TLS y borrar este fichero, no anadir el
  dominio nuevo aqui.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android no entiende subredes aqui: hay que listar cada host.
             10.0.0.0 a secas NO cubria 10.0.0.12 y la app bloqueaba el HTTP. -->
        <domain includeSubdomains="false">10.0.0.12</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
