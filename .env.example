# Copia este fichero a .env y rellena los valores. .env esta en .gitignore.

# Por IP y no por nombre: dentro de Docker el DNS corporativo no resuelve SRVAHORA.
SQLSERVER_HOST=10.0.0.6
SQLSERVER_DB=GOMEZYCRESPO
SQLSERVER_PORT=1433

# Usuario de SOLO LECTURA. Para exportar e inspeccionar.
SQLSERVER_USER=gestor_incidencias
SQLSERVER_PASS=

# Usuario con permiso de escritura sobre dbo.ARTICULOS.
# Dejalo vacio hasta que el administrador de SQL cree uno para esto.
# actualizar_medidas.py --aplicar exige estas dos variables; sin ellas solo hace dry-run.
SQLSERVER_WRITE_USER=
SQLSERVER_WRITE_PASS=

# Valor que se escribe en ARTICULOS.Usuario al actualizar (traza de auditoria).
ERP_USUARIO_AUDITORIA=medidas_bot

# La app no tiene login: la API firma todo lo que escribe en el ERP con este
# nombre (ARTICULOS.Usuario y Objetos_Imagenes.Usuario).
API_USUARIO=ricardo
